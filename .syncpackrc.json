{
  "$schema": "https://unpkg.com/syncpack@latest/dist/schema.json",
  "versionGroups": [
    {
      "label": "Public site/theme packages pin concrete versions of published internal deps: npm publish builds the registry metadata from the on-disk manifest before prepack rewrites it, so workspace:* here ships broken packuments",
      "packages": [
        "@rizom/site",
        "@rizom/site-books",
        "@rizom/site-docs",
        "@rizom/site-hub",
        "@rizom/site-rizom-ai",
        "@rizom/site-rizom-foundation",
        "@rizom/site-rizom-work",
        "@rizom/site-seminar",
        "@rizom/site-thefourth",
        "@rizom/theme-rizom-ai"
      ],
      "dependencies": [
        "@rizom/site",
        "@rizom/site-rizom-ai",
        "@rizom/theme-default"
      ],
      "dependencyTypes": ["local", "prod"]
    },
    {
      "label": "Use workspace protocol for internal packages",
      "dependencies": ["@brains/**", "@rizom/**"],
      "dependencyTypes": ["dev", "prod"],
      "pinVersion": "workspace:*"
    },
    {
      "label": "Pin Bun types",
      "dependencies": ["@types/bun", "bun-types"],
      "dependencyTypes": ["dev"],
      "policy": "sameRange"
    },
    {
      "label": "Sync TypeScript versions",
      "dependencies": ["typescript"],
      "dependencyTypes": ["dev"],
      "policy": "sameRange"
    },
    {
      "label": "Hold the Chat SDK core at the version its adapters use: the root override pins it, since the Matrix adapter's looser range would otherwise lift it past the Discord, Slack and state adapters",
      "dependencies": ["chat"],
      "dependencyTypes": ["prod", "overrides"],
      "policy": "sameRange"
    },
    {
      "label": "Sync Zod versions",
      "dependencies": ["zod"],
      "dependencyTypes": ["dev", "prod"],
      "policy": "sameRange"
    },
    {
      "label": "Sync React versions",
      "dependencies": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "dependencyTypes": ["dev", "prod", "peer"],
      "policy": "sameRange"
    }
  ],
  "semverGroups": [
    {
      "label": "Public site/theme packages pin exact versions of published internal deps",
      "packages": [
        "@rizom/site-books",
        "@rizom/site-docs",
        "@rizom/site-hub",
        "@rizom/site-rizom-ai",
        "@rizom/site-rizom-foundation",
        "@rizom/site-rizom-work",
        "@rizom/site-seminar",
        "@rizom/site-thefourth",
        "@rizom/theme-rizom-ai"
      ],
      "dependencies": [
        "@rizom/site",
        "@rizom/site-rizom-ai",
        "@rizom/theme-default"
      ],
      "dependencyTypes": ["prod"],
      "range": ""
    },
    {
      "label": "Pin the private Effect runtime; upgrades are deliberate",
      "packages": ["@brains/utils"],
      "dependencies": ["effect", "@effect/platform-bun"],
      "dependencyTypes": ["prod"],
      "range": ""
    },
    {
      "label": "Use caret ranges for all dependencies",
      "dependencies": ["**"],
      "dependencyTypes": ["dev", "prod", "peer"],
      "range": "^"
    }
  ],
  "sortFirst": [
    "name",
    "version",
    "description",
    "keywords",
    "license",
    "author"
  ],
  "sortAz": ["scripts", "dependencies", "devDependencies", "peerDependencies"]
}
