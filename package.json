{
  "name": "rizom-brains",
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "devDependencies": {
    "@ai-sdk/anthropic": "^3.0.84",
    "@ai-sdk/openai": "^3.0.71",
    "@changesets/assemble-release-plan": "^6.0.10",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@changesets/config": "^3.1.1",
    "@changesets/parse": "^0.4.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@manypkg/cli": "^0.25.1",
    "@manypkg/get-packages": "^1.1.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/react": "^19.2.17",
    "ai": "^6.0.206",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.5.0",
    "husky": "^9.1.7",
    "ink-testing-library": "^4.0.0",
    "lint-staged": "^17.0.7",
    "playwright-core": "^1.61.0",
    "prettier": "^3.8.4",
    "react": "^19.2.7",
    "sharp": "^0.35.1",
    "syncpack": "^15.3.2",
    "turbo": "^2.9.18",
    "typescript": "^7.0.2",
    "typescript-legacy": "npm:typescript@^6.0.3"
  },
  "engines": {
    "bun": ">=1.3.3",
    "node": ">=24.18.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@types/node": "^24.13.3",
    "zod": "^4.1.8"
  },
  "packageManager": "bun@1.3.11",
  "private": true,
  "scripts": {
    "arch:check": "bun scripts/architecture-check.ts",
    "arch:graph": "bun scripts/architecture-check.ts --reporter dot | dot -T svg > dependency-graph.svg",
    "build": "turbo run build",
    "changeset": "bun scripts/release-lane.ts add",
    "changeset:check": "bun scripts/release-lane.ts check",
    "changeset:publish:core": "bun scripts/publish-packages.ts core",
    "changeset:publish:raw": "changeset publish",
    "changeset:publish:site": "bun scripts/publish-packages.ts site",
    "changeset:raw": "changeset",
    "changeset:version:core": "bun scripts/release-lane.ts version core",
    "changeset:version:raw": "changeset version",
    "changeset:version:site": "bun scripts/release-lane.ts version site",
    "clean": "turbo run clean",
    "clean:all": "turbo run clean && rm -rf node_modules .turbo",
    "deps:check": "syncpack lint",
    "deps:fix": "syncpack fix",
    "deps:format": "syncpack format",
    "deps:update": "syncpack update",
    "dev": "turbo run dev",
    "docs:check": "bun run docs:links && bun run docs:manifest && bun run roadmap:check",
    "docs:links": "bun scripts/check-markdown-links.ts",
    "docs:manifest": "bun scripts/check-docs-manifest.ts",
    "env-schema:check": "bun scripts/sync-env-templates.ts --check",
    "env-schema:sync": "bun scripts/sync-env-templates.ts",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "format:check:core": "bun scripts/format-release-lane.ts core",
    "format:check:site": "bun scripts/format-release-lane.ts site",
    "legacy:check": "bun scripts/check-legacy-code.ts",
    "lint": "bun scripts/lint.mjs",
    "lint:fix": "turbo run lint:fix",
    "prepare": "husky install",
    "roadmap:build": "bun scripts/build-roadmap-visual.ts",
    "roadmap:check": "bun scripts/build-roadmap-visual.ts --check",
    "test": "turbo run test",
    "test:git-broker-process-inventory": "RUN_GIT_ZOMBIE_SOAK=1 GIT_ZOMBIE_SOAK_CYCLES=100 bun test plugins/directory-sync/test/git/git-zombie-soak.test.ts",
    "test:git-broker-recovery": "bun run --filter @rizom/brain build && RUN_GIT_BROKER_PACKAGED_RECOVERY=1 bun test packages/brain-cli/test/git-broker-packaged-recovery.test.ts",
    "test:packed:compat": "bun --filter @rizom/brain test:packed:compat",
    "test:scripts": "bun test scripts/",
    "test:unit": "turbo run test",
    "typecheck": "turbo run typecheck",
    "visual:console": "bun scripts/console-visual-regression.ts",
    "workspace:affected": "turbo run test --filter=[HEAD^1]",
    "workspace:check": "manypkg check",
    "workspace:fix": "manypkg fix",
    "workspace:graph": "turbo run build --graph"
  },
  "trustedDependencies": [],
  "workspaces": [
    "shell/*",
    "shared/*",
    "plugins/*",
    "entities/*",
    "interfaces/*",
    "brains/*",
    "sites/*",
    "packages/*"
  ]
}
