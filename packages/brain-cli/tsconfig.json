{
  "extends": "@brains/typescript-config/base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "isolatedDeclarations": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": [
    "src/model/canonical-brain.ts",
    "test/canonical-brain.test.ts",
    "test/fixtures/**"
  ]
}
