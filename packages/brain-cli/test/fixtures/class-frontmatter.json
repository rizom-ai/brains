{
  "schemas": {
    "ask-content": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "topics": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "topicsHeading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "contactLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "contactNote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "mapCaption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "refusal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "faqHeading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "post": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["generating", "draft", "queued", "published", "failed"]
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "excerpt": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "coverImageId": {
          "type": "string"
        },
        "ogImageId": {
          "type": "string"
        },
        "seriesName": {
          "type": "string"
        },
        "seriesIndex": {
          "type": "number"
        },
        "ogImage": {
          "type": "string",
          "format": "uri"
        },
        "canonicalUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["title", "status", "excerpt", "author"]
    },
    "deck": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["generating", "draft", "queued", "published", "failed"]
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "event": {
          "type": "string"
        },
        "coverImageId": {
          "type": "string"
        },
        "ogImageId": {
          "type": "string"
        }
      },
      "required": ["title", "status"]
    },
    "doc": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "description": {
          "default": null,
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "slug": {
          "default": null,
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["title", "section", "order"]
    },
    "image": null,
    "link": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "draft", "published"]
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "description": {
          "type": "string"
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
          "studioWidget": "provenance"
        },
        "source": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          },
          "required": ["ref", "label"],
          "studioWidget": "provenance"
        }
      },
      "required": ["status", "title", "url", "capturedAt", "source"]
    },
    "note": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["generating", "failed"],
          "studioWidget": "provenance"
        },
        "error": {
          "type": "string",
          "studioWidget": "provenance"
        }
      }
    },
    "project": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["generating", "draft", "published", "failed"]
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "description": {
          "type": "string"
        },
        "year": {
          "type": "number"
        },
        "coverImageId": {
          "type": "string"
        },
        "ogImageId": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["title", "status", "description", "year"]
    },
    "prompt": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "defaultHash": {
          "studioWidget": "hidden",
          "type": "string"
        }
      },
      "required": ["title", "target"]
    },
    "series": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "coverImageId": {
          "default": null,
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["title", "slug"]
    },
    "social-post": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Short descriptive title (3-6 words) for file naming"
        },
        "platform": {
          "type": "string",
          "enum": ["linkedin"],
          "description": "Target platform"
        },
        "status": {
          "type": "string",
          "enum": ["generating", "draft", "queued", "published", "failed"]
        },
        "coverImageId": {
          "description": "Image entity ID for post image",
          "type": "string"
        },
        "documents": {
          "description": "Document attachments for publishing",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "Document entity ID"
              }
            },
            "required": ["id"]
          }
        },
        "publishedAt": {
          "studioWidget": "provenance",
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "platformPostId": {
          "description": "ID from platform after publishing",
          "studioWidget": "provenance",
          "type": "string"
        },
        "sourceEntityId": {
          "description": "Source entity ID if auto-generated",
          "studioWidget": "provenance",
          "type": "string"
        },
        "sourceEntityType": {
          "description": "Source entity type (post, deck)",
          "studioWidget": "provenance",
          "type": "string",
          "enum": ["post", "deck"]
        }
      },
      "required": ["title", "platform", "status"]
    },
    "style-guide": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Style guide name"
        },
        "messaging": {
          "type": "object",
          "properties": {
            "audiences": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "positioning": {
              "type": "string"
            }
          }
        },
        "voice": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string"
            },
            "traits": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "principles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "preferredTerms": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "avoid": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "visual": {
          "type": "object",
          "properties": {
            "artDirection": {
              "type": "string"
            },
            "palette": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "composition": {
              "type": "string"
            },
            "mood": {
              "type": "string"
            },
            "preferred": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "avoid": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": ["name"]
    },
    "wish": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["new", "planned", "in-progress", "done", "declined"]
        },
        "priority": {
          "default": "medium",
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "requested": {
          "default": 1,
          "studioWidget": "provenance",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "declinedReason": {
          "type": "string"
        }
      },
      "required": ["title", "status"]
    },
    "playbook": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "status": {
          "default": "active",
          "type": "string",
          "enum": ["draft", "active", "archived"]
        },
        "audience": {
          "default": "admin",
          "type": "string",
          "enum": ["admin", "trusted", "public"]
        },
        "trigger": {
          "type": "string"
        },
        "lifecycle": {
          "type": "string"
        },
        "once": {
          "type": "boolean"
        },
        "starterText": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "starterPrompt": {
          "type": "string"
        },
        "completionMode": {
          "default": "agent-confirmed",
          "type": "string",
          "enum": ["agent-confirmed", "manual"]
        }
      },
      "required": ["title"]
    },
    "site-info": {
      "type": "object",
      "properties": {
        "represents": {
          "default": "anchor",
          "description": "Identity represented by the site",
          "type": "string",
          "enum": ["brain", "anchor"]
        },
        "title": {
          "description": "Optional site title override",
          "type": "string"
        },
        "description": {
          "description": "Optional site description override",
          "type": "string"
        },
        "copyright": {
          "description": "Copyright notice text",
          "type": "string"
        },
        "logo": {
          "description": "Whether to display logo instead of title text in header",
          "type": "boolean"
        },
        "themeMode": {
          "description": "Default theme mode",
          "type": "string",
          "enum": ["light", "dark"]
        },
        "cta": {
          "description": "Call-to-action configuration",
          "type": "object",
          "properties": {
            "heading": {
              "type": "string",
              "description": "Main CTA heading text"
            },
            "buttonText": {
              "type": "string",
              "description": "Call-to-action button text"
            },
            "buttonLink": {
              "type": "string",
              "description": "URL or anchor for the CTA button"
            }
          },
          "required": ["heading", "buttonText", "buttonLink"]
        },
        "sections": {
          "description": "Optional per-section blurbs, keyed by section id (e.g. 'essays', 'presentations', 'about'). Used by homepage templates that render editorial section headers.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "blurb": {
                "description": "Short italic subtitle under the section title",
                "type": "string"
              }
            }
          }
        },
        "translations": {
          "description": "The site's title, description, copyright and call to action in its other languages, keyed by language tag. A site is built in a language only once it has one.",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "copyright": {
                "type": "string"
              },
              "cta": {
                "type": "object",
                "properties": {
                  "heading": {
                    "type": "string",
                    "description": "Main CTA heading text"
                  },
                  "buttonText": {
                    "type": "string",
                    "description": "Call-to-action button text"
                  },
                  "buttonLink": {
                    "type": "string",
                    "description": "URL or anchor for the CTA button"
                  }
                },
                "required": ["heading", "buttonText", "buttonLink"]
              }
            }
          }
        }
      }
    },
    "document": null
  },
  "obsidian": {
    "post": {
      "fileClass": "---\nfields:\n  - id: title\n    name: title\n    type: Input\n  - id: slug\n    name: slug\n    type: Input\n  - id: status\n    name: status\n    options:\n      '0': generating\n      '1': draft\n      '2': queued\n      '3': published\n      '4': failed\n    type: Select\n  - id: publishedAt\n    name: publishedAt\n    type: Input\n  - id: excerpt\n    name: excerpt\n    type: Input\n  - id: author\n    name: author\n    type: Input\n  - id: coverImageId\n    name: coverImageId\n    type: Input\n  - id: ogImageId\n    name: ogImageId\n    type: Input\n  - id: seriesName\n    name: seriesName\n    type: Input\n  - id: seriesIndex\n    name: seriesIndex\n    type: Number\n  - id: ogImage\n    name: ogImage\n    type: Input\n  - id: canonicalUrl\n    name: canonicalUrl\n    type: Input\nfilesPaths: post\n---\n",
      "template": "---\ntitle: \"{{title}}\"\nslug: \"\"\nstatus: generating\npublishedAt: \"\"\nexcerpt: \"\"\nauthor: \"\"\ncoverImageId: \"\"\nogImageId: \"\"\nseriesName: \"\"\nseriesIndex:\nogImage: \"\"\ncanonicalUrl: \"\"\n---\n\n<!-- Write your content here -->\n",
      "studioFields": [
        {
          "name": "title",
          "label": "Title",
          "widget": "string"
        },
        {
          "name": "slug",
          "label": "Slug",
          "widget": "string",
          "required": false
        },
        {
          "name": "status",
          "label": "Status",
          "widget": "select",
          "options": ["generating", "draft", "queued", "published", "failed"]
        },
        {
          "name": "publishedAt",
          "label": "Published At",
          "widget": "datetime",
          "required": false
        },
        {
          "name": "excerpt",
          "label": "Excerpt",
          "widget": "text"
        },
        {
          "name": "author",
          "label": "Author",
          "widget": "string"
        },
        {
          "name": "coverImageId",
          "label": "Cover Image ID",
          "widget": "image",
          "required": false
        },
        {
          "name": "ogImageId",
          "label": "OG Image ID",
          "widget": "image",
          "required": false
        },
        {
          "name": "seriesName",
          "label": "Series Name",
          "widget": "string",
          "required": false
        },
        {
          "name": "seriesIndex",
          "label": "Series Index",
          "widget": "number",
          "required": false
        },
        {
          "name": "ogImage",
          "label": "OG Image",
          "widget": "string",
          "required": false
        },
        {
          "name": "canonicalUrl",
          "label": "Canonical URL",
          "widget": "string",
          "required": false
        }
      ]
    },
    "playbook": {
      "fileClass": "---\nfields:\n  - id: title\n    name: title\n    type: Input\n  - id: status\n    name: status\n    options:\n      '0': draft\n      '1': active\n      '2': archived\n    type: Select\n  - id: audience\n    name: audience\n    options:\n      '0': admin\n      '1': trusted\n      '2': public\n    type: Select\n  - id: trigger\n    name: trigger\n    type: Input\n  - id: lifecycle\n    name: lifecycle\n    type: Input\n  - id: once\n    name: once\n    type: Boolean\n  - id: starterText\n    name: starterText\n    type: Input\n  - id: description\n    name: description\n    type: Input\n  - id: starterPrompt\n    name: starterPrompt\n    type: Input\n  - id: completionMode\n    name: completionMode\n    options:\n      '0': agent-confirmed\n      '1': manual\n    type: Select\nfilesPaths: playbook\n---\n",
      "template": "---\ntitle: \"{{title}}\"\nstatus: active\naudience: admin\ntrigger: \"\"\nlifecycle: \"\"\nonce: false\nstarterText: \"\"\ndescription: \"\"\nstarterPrompt: \"\"\ncompletionMode: agent-confirmed\n---\n\n<!-- Write your content here -->\n",
      "studioFields": [
        {
          "name": "title",
          "label": "Title",
          "widget": "string"
        },
        {
          "name": "status",
          "label": "Status",
          "widget": "select",
          "required": false,
          "default": "active",
          "options": ["draft", "active", "archived"]
        },
        {
          "name": "audience",
          "label": "Audience",
          "widget": "select",
          "required": false,
          "default": "admin",
          "options": ["admin", "trusted", "public"]
        },
        {
          "name": "trigger",
          "label": "Trigger",
          "widget": "string",
          "required": false
        },
        {
          "name": "lifecycle",
          "label": "Lifecycle",
          "widget": "string",
          "required": false
        },
        {
          "name": "once",
          "label": "Once",
          "widget": "boolean",
          "required": false
        },
        {
          "name": "starterText",
          "label": "Starter Text",
          "widget": "string",
          "required": false
        },
        {
          "name": "description",
          "label": "Description",
          "widget": "text",
          "required": false
        },
        {
          "name": "starterPrompt",
          "label": "Starter Prompt",
          "widget": "string",
          "required": false
        },
        {
          "name": "completionMode",
          "label": "Completion Mode",
          "widget": "select",
          "required": false,
          "default": "agent-confirmed",
          "options": ["agent-confirmed", "manual"]
        }
      ]
    }
  }
}
