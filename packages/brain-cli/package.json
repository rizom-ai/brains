      "import": "./dist/index.js"
    },
    "./cli": "./dist/brain.js",
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "import": "./dist/plugins.js"
    },
    "./entities": {
      "types": "./dist/entities.d.ts",
      "import": "./dist/entities.js"
    },
    "./services": {
      "types": "./dist/services.d.ts",
      "import": "./dist/services.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces.d.ts",
      "import": "./dist/interfaces.js"
    },
    "./templates": {
      "types": "./dist/templates.d.ts",
      "import": "./dist/templates.js"
    },
    "./deploy": {
      "types": "./dist/deploy.d.ts",
      "import": "./dist/deploy.js"
    },
    "./tsconfig.instance.json": "./tsconfig.instance.json"
  },
  "files": [
    "dist",
    "templates",
    "tsconfig.instance.json"
  ],
  "homepage": "https://github.com/rizom-ai/brains/tree/main/packages/brain-cli#readme",
  "optionalDependencies": {
    "@bitwarden/sdk-napi": "^1.0.0",
    "@libsql/client": "^0.17.4",
    "@tailwindcss/oxide": "^4.1.4",
    "lightningcss": "^1.29.2",
    "react-devtools-core": "^7.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rizom-ai/brains.git",
    "directory": "packages/brain-cli"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:ui": "turbo run build --filter=@brains/web-chat --filter=@brains/studio",
    "dev:start": "bun scripts/build.ts && bun dist/brain.js start",
    "eval": "brain-eval",
    "eval:headless": "brain-eval --suite headless",
    "eval:personal": "brain-eval --suite personal",
    "eval:professional": "brain-eval --suite professional",
    "eval:team": "brain-eval --suite team",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "prepublishOnly": "bun scripts/build.ts",
    "start:minimal": "bun run build:ui && cd test-apps/minimal && INIT_CWD=$PWD exec bun --no-orphans run $([ -t 1 ] && echo --elide-lines=0) --filter @rizom/brain dev:start",
    "start:unified-inbox": "bun run build:ui && cd test-apps/unified-inbox && INIT_CWD=$PWD exec bun --no-orphans run $([ -t 1 ] && echo --elide-lines=0) --filter @rizom/brain dev:start",
    "start:personal": "bun run build:ui && cd test-apps/personal && INIT_CWD=$PWD exec bun --no-orphans run $([ -t 1 ] && echo --elide-lines=0) --filter @rizom/brain dev:start",
    "start:publishing": "bun run build:ui && cd test-apps/publishing && INIT_CWD=$PWD exec bun --no-orphans run $([ -t 1 ] && echo --elide-lines=0) --filter @rizom/brain dev:start",
    "start:team": "bun run build:ui && cd test-apps/team && INIT_CWD=$PWD exec bun --no-orphans run $([ -t 1 ] && echo --elide-lines=0) --filter @rizom/brain dev:start",
    "test": "bun test --parallel=4 --path-ignore-patterns='**/boot-smoke.test.ts' && bun run test:boot-smoke:prebuilt",
    "test:boot-smoke": "bun run build && bun run test:boot-smoke:prebuilt",
    "test:boot-smoke:prebuilt": "bun test test/boot-smoke.test.ts",
    "test:packed:compat": "bun scripts/run-packed-compatibility.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.model.json"
  },
  "type": "module"
}
