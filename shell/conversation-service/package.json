{
  "name": "@brains/conversation-service",
  "license": "AGPL-3.0-only",
  "version": "0.2.0-alpha.355",
  "description": "Conversation storage and retrieval service for Brains",
  "dependencies": {
    "@brains/contracts": "workspace:*",
    "@brains/db": "workspace:*",
    "@brains/messaging-service": "workspace:*",
    "@brains/utils": "workspace:*",
    "@libsql/client": "^0.17.4",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@brains/test-utils": "workspace:*",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.13.3",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
