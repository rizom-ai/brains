"/*
 * Shared operator-console tokens and chrome.
 *
 * Both climates alias the injected brain theme. Climate selects data-theme,
 * so paper consumes its light semantic palette and instrument its dark one.
 * Console chrome owns no brand colour values of its own.
 */

[data-climate="instrument"] {
  --console-bg: var(--color-bg);
  --console-frame: var(--color-bg-subtle);
  --console-card: var(--color-bg-card);
  --console-card-soft: var(--color-bg-muted);
  --console-bg-deep: var(--color-bg-deep);
  --console-text: var(--color-text);
  --console-text-dim: var(--color-text-muted);
  --console-text-muted: var(--color-text-light);
  --console-text-faint: var(--color-border);
  --console-accent: var(--color-accent);
  --console-secondary: var(--color-secondary);
  --console-ok: var(--color-success);
  --console-warn: var(--color-warning);
  --console-err: var(--color-error);
  --console-on-accent: var(--color-on-accent);
  --console-shadow-card:
    0 1px 0 color-mix(in srgb, var(--console-text) 3%, transparent) inset,
    0 24px 58px -30px
      color-mix(in srgb, var(--console-bg-deep) 72%, transparent);
  color-scheme: dark;
}

[data-climate="paper"] {
  --console-bg: var(--color-bg);
  --console-frame: var(--color-bg-subtle);
  --console-card: var(--color-bg-card);
  --console-card-soft: var(--color-bg-muted);
  --console-bg-deep: var(--color-bg-deep);
  --console-text: var(--color-text);
  --console-text-dim: var(--color-text-muted);
  --console-text-muted: var(--color-text-light);
  --console-text-faint: var(--color-border);
  --console-accent: var(--color-accent);
  --console-secondary: var(--color-secondary);
  --console-ok: var(--color-success);
  --console-warn: var(--color-warning);
  --console-err: var(--color-error);
  --console-on-accent: var(--color-on-accent);
  --console-shadow-card:
    0 1px 0 color-mix(in srgb, var(--console-text) 3%, transparent) inset,
    0 22px 44px -30px
      color-mix(in srgb, var(--console-bg-deep) 30%, transparent);
  color-scheme: light;
}

[data-climate] {
  --console-neutral: var(--console-text-muted);
  --console-rule: color-mix(in srgb, var(--console-text) 7%, transparent);
  --console-rule-strong: color-mix(
    in srgb,
    var(--console-text) 14%,
    transparent
  );
  --console-rule-accent: color-mix(
    in srgb,
    var(--console-accent) 48%,
    transparent
  );
  --console-accent-dim: color-mix(
    in srgb,
    var(--console-accent) 72%,
    var(--console-bg-deep)
  );
  --console-accent-soft: color-mix(
    in srgb,
    var(--console-accent) 12%,
    transparent
  );
  --console-secondary-soft: color-mix(
    in srgb,
    var(--console-secondary) 12%,
    transparent
  );
  --console-ok-soft: color-mix(in srgb, var(--console-ok) 13%, transparent);
  --console-display: var(--font-display, "Fraunces", "Times New Roman", serif);
  --console-ui: var(
    --font-body,
    "IBM Plex Sans",
    -apple-system,
    system-ui,
    sans-serif
  );
  --console-mono: var(--font-label, "JetBrains Mono", ui-monospace, monospace);
  --console-touch: 44px;
}

/* ---- cross-surface command palette -------------------------------------- */

.console-palette-open {
  overflow: hidden;
}
.console-palette-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: none;
  place-items: start center;
  padding: 9vh 20px 20px;
  background: color-mix(in srgb, var(--console-bg-deep) 68%, transparent);
  backdrop-filter: blur(4px);
}
.console-palette-overlay.is-open {
  display: grid;
}
.console-palette {
  width: min(580px, 100%);
  overflow: hidden;
  border: 1px solid var(--console-rule-strong);
  border-radius: 14px;
  background: var(--console-card);
  box-shadow: 0 40px 90px -20px
    color-mix(in srgb, var(--console-bg-deep) 58%, transparent);
}
.cp-input-row {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 58px;
  padding: 0 18px;
  border-bottom: 1px solid var(--console-rule-strong);
}
.cp-input-row::before {
  content: "⌕";
  color: var(--console-accent);
  font-family: var(--console-mono);
  font-size: 18px;
}
.cp-input {
  min-width: 0;
  flex: 1;
  padding: 12px 0;
  border: none;
  outline: none;
  background: transparent;
  color: var(--console-text);
  font-family: var(--console-ui);
  font-size: 15px;
}
.cp-input::placeholder {
  color: var(--console-text-muted);
}
.cp-esc {
  padding: 1px 6px;
  border: 1px solid var(--console-rule-strong);
  border-bottom-width: 2px;
  border-radius: 4px;
  color: var(--console-text-muted);
  font-family: var(--console-mono);
  font-size: 10px;
}
.cp-groups {
  max-height: 48vh;
  overflow-y: auto;
  padding-bottom: 6px;
}
.cp-group {
  padding: 7px 0 4px;
}
.cp-group + .cp-group {
  border-top: 1px solid var(--console-rule);
}
.cp-group-title {
  padding: 4px 18px 5px;
  color: var(--console-text-muted);
  font-family: var(--console-mono);
  font-size: 9.5px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}
.cp-row {
  display: grid;
  grid-template-columns: 16px minmax(0, 1fr) auto;
  gap: 3px 11px;
  align-items: baseline;
  min-height: 42px;
  padding: 8px 18px;
  border-left: 2px solid transparent;
  color: inherit;
  cursor: pointer;
  text-decoration: none;
}
.cp-row:hover {
  background: var(--console-rule);
}
.cp-row.is-selected {
  border-left-color: var(--console-accent);
  background: var(--console-accent-soft);
}
.cp-glyph {
  grid-row: span 2;
  color: var(--console-accent);
  font-family: var(--console-mono);
  font-size: 10px;
  text-align: center;
}
.cp-title {
  min-width: 0;
  color: var(--console-text);
  font-size: 13.5px;
}
.cp-title mark {
  background: none;
  color: var(--console-accent);
  font-weight: 500;
}
.cp-sub {
  grid-column: 2;
  color: var(--console-text-muted);
  font-family: var(--console-mono);
  font-size: 10px;
}
.cp-tag {
  grid-column: 3;
  grid-row: 1 / span 2;
  align-self: center;
  padding: 1px 9px;
  border: 1px solid var(--console-rule-strong);
  border-radius: 999px;
  color: var(--console-text-dim);
  font-family: var(--console-mono);
  font-size: 9.5px;
  letter-spacing: 0.08em;
  white-space: nowrap;
}
.cp-empty {
  padding: 16px 18px;
  color: var(--console-text-muted);
  font-size: 13px;
}
.cp-foot {
  display: flex;
  gap: 18px;
  padding: 9px 18px;
  border-top: 1px solid var(--console-rule-strong);
  color: var(--console-text-muted);
  font-family: var(--console-mono);
  font-size: 9.5px;
}
.cp-foot span:last-child {
  margin-left: auto;
}

@media (max-width: 640px) {
  .console-palette-overlay {
    place-items: stretch;
    padding: 0;
    background: var(--console-card);
    backdrop-filter: none;
  }
  .console-palette {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    width: 100%;
    height: 100dvh;
    max-width: none;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }
  .cp-input-row {
    min-height: calc(68px + env(safe-area-inset-top));
    padding: env(safe-area-inset-top) 16px 0;
  }
  .cp-input {
    font-size: 16px;
  }
  .cp-groups {
    max-height: none;
  }
  .cp-row {
    min-height: 54px;
    padding: 10px 16px;
  }
  .cp-tag {
    display: none;
  }
  .cp-foot {
    justify-content: center;
    padding-bottom: calc(12px + env(safe-area-inset-bottom));
  }
  .cp-foot span:not(:last-child) {
    display: none;
  }
  .cp-foot span:last-child {
    margin-left: 0;
  }
}


/* Document reset; component presentation is compiled in shared StyleX. */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
html {
  min-height: 100%;
  max-width: 100%;
}


