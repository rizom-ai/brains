{
  "lexicon": 1,
  "id": "ai.rizom.brain.book",
  "defs": {
    "main": {
      "type": "record",
      "description": "Public book from a Rizom brain: what the book is, not its text.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["title", "createdAt"],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 300
          },
          "author": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          },
          "kind": {
            "type": "string",
            "knownValues": ["work", "nachlass", "letters", "excerpt"]
          },
          "edition": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "attribution": {
            "type": "string",
            "maxLength": 2000
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "canonicalUrl": {
            "type": "string",
            "format": "uri"
          },
          "brainDid": {
            "type": "string"
          },
          "anchorDid": {
            "type": "string"
          },
          "sourceEntityType": {
            "type": "string"
          },
          "sourceEntityId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
