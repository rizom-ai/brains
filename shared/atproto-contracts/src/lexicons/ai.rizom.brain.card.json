{
  "lexicon": 1,
  "id": "ai.rizom.brain.card",
  "defs": {
    "main": {
      "type": "record",
      "description": "Public discovery card for a Rizom brain. A web-capable brain may advertise its operational A2A Agent Card through siteUrl; federation-only brains remain discoverable through this PDS record.",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": [
          "brain",
          "anchor",
          "skills",
          "model",
          "version",
          "createdAt"
        ],
        "properties": {
          "siteUrl": {
            "type": "string",
            "format": "uri",
            "description": "Optional public web-channel URL. Consumers may derive the A2A Agent Card URL from this base when present."
          },
          "brain": {
            "type": "ref",
            "ref": "#brain",
            "description": "Brain identity described by this discovery card."
          },
          "anchor": {
            "type": "ref",
            "ref": "#anchor",
            "description": "Minimal Anchor snapshot for discovery grouping and display."
          },
          "skills": {
            "type": "array",
            "description": "User-facing skills this brain advertises for discovery.",
            "items": {
              "type": "ref",
              "ref": "#skill"
            },
            "maxLength": 100
          },
          "model": {
            "type": "string",
            "description": "Rizom brain model identifier."
          },
          "version": {
            "type": "string",
            "description": "Brain runtime/model implementation version."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    },
    "brain": {
      "type": "object",
      "description": "Brain identity described by this discovery card.",
      "required": ["did", "name", "role", "purpose", "values"],
      "properties": {
        "did": {
          "type": "string",
          "description": "Public DID for the brain identity."
        },
        "name": {
          "type": "string",
          "maxLength": 200,
          "description": "Human-readable brain name."
        },
        "role": {
          "type": "string",
          "maxLength": 500,
          "description": "Brain role or persona."
        },
        "purpose": {
          "type": "string",
          "maxLength": 2000,
          "description": "Short public description of what this brain is for."
        },
        "values": {
          "type": "array",
          "description": "Public values or principles for this brain.",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "maxLength": 50
        }
      }
    },
    "anchor": {
      "type": "object",
      "description": "Minimal Anchor snapshot for discovery grouping and display.",
      "required": ["did", "name", "category", "kind"],
      "properties": {
        "did": {
          "type": "string",
          "description": "Public DID for the Anchor identity."
        },
        "name": {
          "type": "string",
          "maxLength": 200,
          "description": "Human-readable anchor name."
        },
        "category": {
          "type": "string",
          "knownValues": ["person", "team", "organization"],
          "description": "Stable structural category for discovery and grouping."
        },
        "kind": {
          "type": "string",
          "maxLength": 200,
          "description": "Open semantic profile kind selected by the publishing brain."
        }
      }
    },
    "skill": {
      "type": "object",
      "description": "User-facing skill this brain advertises for discovery.",
      "required": ["id", "name", "description"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxLength": 50
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxLength": 20
        }
      }
    }
  }
}
